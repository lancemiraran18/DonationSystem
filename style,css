/* --- Base Variables & Reset --- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
    --primary: #4f46e5;
    --primary-hover: #4338ca;
    --secondary: #0f172a;
    --accent-blue: #3b82f6;
    --accent-green: #10b981;
    --accent-purple: #8b5cf6;
    --accent-red: #ef4444;
    --bg-main: #f8fafc;
    --bg-surface: #ffffff;
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --border-light: #e2e8f0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
    --radius-md: 8px;
    --radius-lg: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    -webkit-tap-highlight-color: transparent;
}

body {
    background-color: var(--bg-main);
    color: var(--text-dark);
    line-height: 1.5;
    overflow-x: hidden;
}

.hidden { display: none !important; }
.mobile-only { display: none !important; }
.desktop-only { display: flex; }

/* --- Animations --- */
.fade-in { animation: fadeIn 0.4s ease-in-out forwards; }
.fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
}

/* --- Buttons & Inputs --- */
input, select {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-size: 14px;
    outline: none;
    transition: all 0.3s;
    background: #fdfdfd;
    min-height: 44px;
}

input:focus, select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
}

button {
    cursor: pointer;
    border: none;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.3s ease;
    min-height: 44px;
}

.btn-primary { background-color: var(--primary); color: white; box-shadow: var(--shadow-sm); }
.btn-primary:hover { background-color: var(--primary-hover); transform: translateY(-1px); box-shadow: var(--shadow-md); }
.btn-secondary { background-color: transparent; border: 1px solid var(--border-light); color: var(--text-dark); }
.btn-secondary:hover { background-color: #f1f5f9; }
.bg-green-btn { background-color: var(--accent-green); }
.bg-green-btn:hover { background-color: #059669; }

/* --- Auth Screen --- */
.auth-wrapper {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
}

.auth-card {
    background: var(--bg-surface);
    padding: 40px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 420px;
    position: relative;
}

.auth-header { text-align: center; margin-bottom: 30px; }
.auth-header .logo-icon { font-size: 40px; color: var(--primary); margin-bottom: 10px; }
.auth-header h2 { font-size: 24px; font-weight: 700; color: var(--secondary); }
.auth-header p { color: var(--text-muted); font-size: 14px; }

.input-icon { position: relative; margin-bottom: 20px; }
.input-icon i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
.input-icon input { padding-left: 45px; }

.auth-form button { width: 100%; margin-top: 10px; padding: 14px; }
.auth-switch { text-align: center; margin-top: 20px; font-size: 14px; color: var(--text-muted); }
.auth-switch span { color: var(--primary); font-weight: 600; cursor: pointer; transition: 0.2s; }
.auth-switch span:hover { text-decoration: underline; }

/* --- App Layout --- */
.app-wrapper { display: flex; height: 100vh; overflow: hidden; position: relative; }

/* Sidebar Drawer Overlay for Mobile */
.sidebar-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(2px);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.sidebar-overlay.active { opacity: 1; visibility: visible; }

/* Sidebar */
.sidebar {
    width: 260px;
    background: var(--secondary);
    color: white;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
    z-index: 999;
}

.sidebar-brand {
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 20px;
    font-weight: 700;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}
.sidebar-brand i { color: var(--primary); font-size: 24px; }

.nav-links { padding: 20px 12px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
.nav-btn {
    background: transparent;
    color: #94a3b8;
    justify-content: flex-start;
    padding: 14px 16px;
    font-weight: 500;
    border-radius: var(--radius-md);
}
.nav-btn:hover { background: rgba(255,255,255,0.05); color: white; }
.nav-btn.active { background: var(--primary); color: white; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4); }

.sidebar-footer { padding: 20px; border-top: 1px solid rgba(255,255,255,0.1); }
.sidebar-footer button { width: 100%; color: white; border-color: rgba(255,255,255,0.2); }
.sidebar-footer button:hover { background: rgba(255,255,255,0.1); color: white; }

/* Main Area */
.main-wrapper { flex-grow: 1; display: flex; flex-direction: column; background: var(--bg-main); width: 100%; }

.top-header {
    background: var(--bg-surface);
    height: 70px;
    padding: 0 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-light);
}

.header-left { display: flex; align-items: center; gap: 16px; }

.header-search { position: relative; width: 280px; }
.header-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
.header-search input { padding: 10px 10px 10px 40px; border-radius: 20px; background: var(--bg-main); border: none; min-height: 40px; }

.header-profile { display: flex; align-items: center; gap: 16px; }
.icon-btn { background: none; color: var(--text-muted); font-size: 18px; padding: 8px; border-radius: 50%; min-height: 40px; min-width: 40px; }
.icon-btn:hover { background: var(--bg-main); color: var(--text-dark); }
.avatar { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; }
.avatar img { width: 36px; height: 36px; border-radius: 50%; }

.text-white { color: white !important; }

.main-content { padding: 32px; overflow-y: auto; height: calc(100vh - 70px); }

/* Section Headers */
.section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; gap: 16px; }
.section-header h1 { font-size: 24px; color: var(--secondary); font-weight: 700; margin-bottom: 4px; }
.section-header p { color: var(--text-muted); font-size: 14px; }

/* Dashboard Cards */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px; }
.stat-card {
    background: var(--bg-surface); padding: 20px; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); border: 1px solid var(--border-light);
    display: flex; align-items: center; gap: 16px; transition: 0.3s;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: white; flex-shrink: 0; }
.bg-blue { background: linear-gradient(135deg, #3b82f6, #2563eb); }
.bg-green { background: linear-gradient(135deg, #10b981, #059669); }
.bg-purple { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.stat-details h3 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
.stat-details p { font-size: 26px; font-weight: 700; color: var(--secondary); }

/* Cards & Forms */
.card {
    background: var(--bg-surface); padding: 24px; border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); margin-bottom: 24px;
}
.card h3 { font-size: 16px; margin-bottom: 20px; color: var(--secondary); display: flex; align-items: center; gap: 10px; }
.card h3 i { color: var(--primary); }

.inline-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; align-items: end; }
.input-wrapper label { display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 8px; }
.btn-submit { height: 44px; width: 100%; }

/* Tables */
.table-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 12px; flex-wrap: wrap; }
.search-box { position: relative; width: 100%; max-width: 240px; }
.search-box i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 13px; }
.search-box input { padding: 8px 12px 8px 32px; border-radius: 20px; font-size: 13px; min-height: 38px; }

.table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
table { width: 100%; border-collapse: collapse; white-space: nowrap; }
th, td { padding: 14px 16px; border-bottom: 1px solid var(--border-light); text-align: left; }
th { font-size: 12px; text-transform: uppercase; color: var(--text-muted); font-weight: 600; background: #f8fafc; }
td { font-size: 14px; color: var(--text-dark); }
td strong { color: var(--secondary); }

/* Badges & Actions */
.badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-block; }
.badge.in-stock { background: #d1fae5; color: #065f46; }
.badge.low-stock { background: #fef3c7; color: #92400e; }
.badge.out-stock { background: #fee2e2; color: #991b1b; }

.action-btn { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 6px; font-size: 16px; min-height: auto; }
.action-btn:hover { color: var(--primary); }

/* Activity Feed */
.activity-list { list-style: none; }
.activity-list li { padding: 14px 0; border-bottom: 1px solid var(--border-light); display: flex; gap: 14px; align-items: flex-start; }
.activity-list li:last-child { border-bottom: none; }
.activity-icon { width: 36px; height: 36px; border-radius: 50%; background: #e0e7ff; color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.activity-text p { font-size: 14px; margin-bottom: 2px; word-break: break-word; }
.activity-text small { color: var(--text-muted); font-size: 12px; }
.empty-state { color: var(--text-muted); font-style: italic; font-size: 14px; }

/* Toast Notifications */
#toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: calc(100vw - 40px); }
.toast {
    background: white; border-left: 4px solid var(--primary);
    padding: 14px 18px; border-radius: 6px; box-shadow: var(--shadow-lg);
    display: flex; align-items: center; gap: 12px; font-size: 14px;
    animation: slideInRight 0.3s ease forwards;
}
.toast i { font-size: 18px; }
.toast.success { border-color: var(--accent-green); }
.toast.success i { color: var(--accent-green); }
.toast.error { border-color: var(--accent-red); }
.toast.error i { color: var(--accent-red); }

@keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes fadeOut { to { opacity: 0; transform: translateY(-10px); } }

/* --- RESPONSIVE MEDIA QUERIES --- */

/* Tablets & Small Laptops (< 1024px) */
@media (max-width: 1024px) {
    .main-content { padding: 24px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

/* Mobile Devices (< 768px) */
@media (max-width: 768px) {
    .mobile-only { display: flex !important; }
    .desktop-only { display: none !important; }

    /* Auth screen mobile adjustments */
    .auth-card { padding: 28px 20px; }
    
    /* Sidebar Drawer Slide Mechanism */
    .sidebar {
        position: fixed;
        top: 0; left: -280px;
        height: 100vh;
        width: 270px;
        box-shadow: var(--shadow-lg);
    }
    
    .sidebar.active { left: 0; }

    .top-header { padding: 0 16px; height: 60px; }
    .main-content { padding: 16px; height: calc(100vh - 60px); }

    /* Stack header and action buttons */
    .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }
    .export-btn { width: 100%; }

    /* Single Column Layouts */
    .stats-grid { grid-template-columns: 1fr; gap: 14px; }
    .inline-form { grid-template-columns: 1fr; gap: 14px; }
    
    .card { padding: 18px 16px; margin-bottom: 16px; }
    
    /* Search box takes full width in card headers */
    .table-header { flex-direction: column; align-items: flex-start; }
    .search-box { max-width: 100%; }

    /* Toasts position on mobile */
    #toast-container { left: 20px; right: 20px; bottom: 16px; }
    .toast { width: 100%; }
}
